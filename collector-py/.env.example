# 复制一份改名为 .env 后生效。.env 已被 .gitignore 忽略，不会进版本库。

# ---- Redis：采集侧只负责往 Stream 里写，不读业务数据 ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
STREAM_KEY=cs2:listings

# ---- 采集节奏 ----
POLL_INTERVAL=60        # 单个监控标的的轮询周期（秒），不要低于 30
REQUEST_TIMEOUT=15      # 单次请求超时（秒）
LOG_LEVEL=INFO

# ---- 平台登录态 ----
# 不要写在这。放 data/credentials.json，用 AES-GCM 加密，
# 密钥通过系统环境变量 CS2_CRED_KEY 注入，不进仓库也不进本文件。
# 生成：.venv\Scripts\python.exe -c "from core.credentials import generate_key; print(generate_key())"

# ---- 数据保留 ----
SNAPSHOT_RETENTION_DAYS=30
